NODE_ENV=
PORT=
API_PREFIX=
SWAGGER_ENABLED=

# RabbitMQ
RABBITMQ_URL=
EVENT_EXCHANGE=
# This worker's own mailbox on the broker. Its default value
# ("DOCUMENT_WORKER_QUEUE") is deliberately in caps so it is never mistaken
# for the routing key below — a queue is *who consumes*, a routing key is
# *what happened*. The dead-letter queue is derived as <value>_DEAD.
EVENT_QUEUE=

# The event this worker binds to. A contract with the publisher, not a
# preference: if this and the publisher disagree, the exchange routes the
# message to no queue and drops it silently. Change both together.
EVENT_ROUTING_KEY=

# The event this worker announces once a document is stored. Nothing has to
# bind to it — an unbound routing key on a topic exchange is a silent no-op,
# not an error — but a publisher waiting to hear it needs to know what it's
# called.
EVENT_COMPLETION_ROUTING_KEY=

RABBITMQ_PREFETCH=

# Object storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
