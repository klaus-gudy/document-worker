# Copy to `.env` and fill in the placeholders:
#
#   cp .env.example .env
#
# The values below are the local infrastructure from Jarvis's
# `docker-compose.yml` and work as written after `docker compose up -d` there.
#
# This worker has **no database**. It renders the HTML it is sent and stores the
# result; whatever record that result belongs on is the requester's business.
# What it does share with the app is the broker and the bucket, and those values
# must match or the two will talk past each other.

# ---------------------------------------------------------------------------
# Process
# ---------------------------------------------------------------------------

NODE_ENV=development

# The health endpoint's port. Shifted off Jarvis's 3347 so both can run locally.
# The worker serves nothing else over HTTP — its input is the queue.
PORT=3400

# ---------------------------------------------------------------------------
# Events — RabbitMQ
# ---------------------------------------------------------------------------
#
# Host port is 5682, not 5672, matching Jarvis's docker-compose.
# Management UI: http://localhost:15682 (guest/guest).
RABBITMQ_URL=amqp://guest:guest@localhost:5682

# The topic exchange. This worker consumes `document.requested` from it and
# publishes `document.generated` / `document.failed` back to it. The dead-letter
# exchange is derived (`jarvis.events.dlx`), so only this is set.
EVENTS_EXCHANGE=jarvis.events

# One queue per *job*. The dead-letter queue is derived
# (`documents.generate.dead`).
DOCUMENT_QUEUE=documents.generate

# How many documents to render at once. Each render holds a Chromium page open,
# so the honest ceiling is memory — raise this against a measured box, not on
# principle.
DOCUMENT_PREFETCH=1

# One retry, then the dead-letter queue. A render or storage failure is usually
# transient and worth one more go; anything that fails twice is not, and
# retrying forever would spin this process on one poisoned message.
DOCUMENT_MAX_ATTEMPTS=2

# ---------------------------------------------------------------------------
# File storage — the SAME bucket the Jarvis app reads from
# ---------------------------------------------------------------------------
#
# Local: MinIO from Jarvis's docker-compose.yml. Its `minio-init` service
# creates the bucket, so these work as written.
#   http://localhost:9000  - S3 API (this endpoint)
#   http://localhost:9001  - console, same credentials
#
# Production: Cloudflare R2. Only these values change — the endpoint becomes
# https://<account-id>.r2.cloudflarestorage.com and the keys become a scoped
# R2 API token rather than a root user.
#
# The bucket is private and stays private. This worker writes objects and
# publishes their KEY; reads go back through the app, which checks the caller's
# organization first.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=jarvis-files
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin123

# R2 ignores the region and MinIO has none, but the SDK refuses to build a
# request without one. "auto" is what Cloudflare's own documentation uses.
STORAGE_REGION=auto
